# 1. builder
FROM node:22-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

#2. production
FROM node:22-slim AS production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

#3. runner
FROM node:22-alpine AS runner
WORKDIR /app
COPY --from=production --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/dist ./dist
USER node
EXPOSE 4000
CMD ["node", "dist/frontend/server/server.mjs"]


#docker build -f dockerfiles/dockerfile  -t litetechne-frontend .
#desde /frontend por el package.json y package-lock.json


# --chown=node:node asigna como dueño de los archivos copiados al usuario "node"
# (uid 1000) que ya trae la imagen base. Sin esto quedarían como root:root,
# porque COPY usa root como dueño por defecto.
#
# NO cifra nada y NO cambia los permisos: solo cambia el dueño. COPY deja los
# archivos legibles por todos (644 en archivos, 755 en carpetas) y esta app
# solo LEE, así que sin --chown también funciona igual.
#
# Se incluye por higiene y porque SÍ importaría si en el futuro la app
# necesitara escribir en /app (cache, uploads, logs), o si los permisos
# cambiaran y aparecieran errores "Permission denied".

# EXPOSE 9999 No abre nada, solo declara. Inofensiva,déjala.

# Comando por defecto: Node carga el bundle SSR y queda como PID 1 sirviendo :4000.
# Forma de array para que Node sea el PID 1 y reciba SIGTERM directo (cierre limpio);
# con shell form, /bin/sh sería el PID 1 y docker stop terminaría con SIGKILL.
# Sin esta línea heredaría `CMD ["node"]` de la imagen base: abriría un REPL,
# leería EOF de stdin y el contenedor saldría al instante sin servir nada.