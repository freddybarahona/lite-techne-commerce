      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "arquitecturas \ngeneral:\nmicroservicios\nindividual:\nhexagonal\nframework(backend):\nnodejs\nframework(frontend):\nangular\n\ncomunicador asincrono(Rabbitmq):\nEntre catalogo, \ninventory y reports\n\ncomunicacion sincrona(normal):\nEntre angular el gateway y catalog.\nesto es para consultas\n",
      "autoResize": true,
