      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "http rest entre servicios son json:\n{\n  \"id\": 123,\n  \"name\": \"Freddy\",\n  \"status\": \"ACTIVE\"\n}\nse necesita para el paso de informacion entre microservicios\n\nrabbitmq y kafka son sistemas para enviar mensajes entrwe servicios envian un loan approved y da el json como un correo interno \nme decanto por rabbitMQ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "k8atUZPfxuoTpCph077k7",
      "type": "text",
      "x": 6065.985494116717,
      "y": 1410.8472267535924,
      "width": 437.20880126953125,
      "height": 1715.8536585365853,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
